; Symbigram Turkish language pack (add-on).
;
; Installs one .qm into the folder Symbigram scans for add-on languages. No executable, no
; capabilities - it is a data-only package, so a self-signed certificate is enough.
&EN

; name, package UID (one past Symbigram's own 0xE4B1C2D3), version, TYPE=SA
#{"Symbigram Turkish"}, (0xE4B1C2D4), 1, 0, 0, TYPE=SA

%{"Symnok"}
:"Symnok"

"symbigram_tr.qm" - "C:\Data\Symbigram\translations\symbigram_tr.qm"
